# Copia este fichero a .env y rellena tus datos. NUNCA subas .env al repo.
HA_URL=http://homeassistant.local:8123
HA_TOKEN=pega-aqui-tu-token-de-larga-duracion
PORT=8090
DATA_TTL=300
# Entidades de HA (ajusta a las tuyas)
WEATHER_ENTITY=weather.home
# Rotulo de la cabecera del PNG (p. ej. el nombre de tu casa)
TITLE=CASA
PRICE_ENTITY=sensor.esios_pvpc
